---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import ScrollToTop from "../components/ui/ScrollToTop.astro";
import { ClientRouter } from "astro:transitions";
import { storeConfig } from "../config/store.config";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title
  ? `${title} | ${storeConfig.name}`
  : `${storeConfig.name} — ${storeConfig.tagline}`;
const pageDescription = description || storeConfig.description;

// Función para convertir Hex a RGB (necesario para Tailwind con variables CSS)
function hexToRgb(hex: string) {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result 
    ? `${parseInt(result[1], 16)} ${parseInt(result[2], 16)} ${parseInt(result[3], 16)}`
    : "244 63 94"; // Fallback rosa
}
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={storeConfig.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    {/* Inyección dinámica de colores desde store.json */}
    <style define:vars={{
      primaryRgb: hexToRgb(storeConfig.theme?.primary || "#f43f5e"),
      accentRgb: hexToRgb(storeConfig.theme?.accent || "#8b5cf6"),
      surfaceRgb: hexToRgb(storeConfig.theme?.surface || "#ffffff")
    }}>
      :root {
        --color-primary: var(--primaryRgb);
        --color-accent: var(--accentRgb);
        --color-surface: var(--surfaceRgb);
      }
    </style>

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={storeConfig.siteUrl} />

    <!-- View Transitions -->
    <ClientRouter />
    
    <!-- Theme Detection (Immediate) -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const theme = getTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      
      window.localStorage.setItem('theme', theme);

      // Listen for view transitions to re-apply theme logic if needed
      document.addEventListener('astro:after-swap', () => {
        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      });
    </script>

    <!-- Client-side Global Store Config -->
    <script define:vars={{ storeConfig }}>
      window.__STORE_CONFIG__ = storeConfig;
      document.addEventListener('astro:after-swap', () => {
        window.__STORE_CONFIG__ = storeConfig;
      });
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-surface-50 dark:bg-surface-900 text-slate-800 dark:text-slate-100 transition-colors duration-300">
    <Header />

    <main class="flex-1" transition:animate="fade">
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <ThemeToggle />

    <!-- WhatsApp Floating Button -->
    <a
      href={`https://wa.me/${storeConfig.whatsappNumber}`}
      target="_blank"
      rel="noopener"
      class="fixed bottom-6 right-6 z-40 w-14 h-14 bg-[#25D366] rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-110 transition-all animate-pulse-glow"
      aria-label="Contactar por WhatsApp"
    >
      <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
    </a>
  </body>
</html>
