---
// CartButton.astro — Shows cart icon with item count badge
---

<a
  href="/carrito"
  id="cart-button"
  class="relative p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all"
  aria-label="Ver carrito"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
  </svg>
  <span
    id="cart-count-badge"
    class="absolute -top-1 -right-1 w-5 h-5 bg-emerald-600 text-white text-xs font-bold rounded-full flex items-center justify-center hidden transition-all"
  >
    0
  </span>
</a>

<script>
  import { cartCount, initCart } from "../../stores/cartStore";

  function setupCartBadge() {
    initCart();

    const badge = document.getElementById("cart-count-badge");
    if (!badge) return;

    function updateBadge(count: number) {
      if (!badge) return;
      badge.textContent = count > 99 ? "99+" : String(count);
      if (count > 0) {
        badge.classList.remove("hidden");
        // Add a small animation only if it's a change or first load
        badge.classList.add("animate-bounce");
        setTimeout(() => {
          if (badge) badge.classList.remove("animate-bounce");
        }, 500);
      } else {
        badge.classList.add("hidden");
      }
    }

    // Initial state
    updateBadge(cartCount.get());

    // Subscribe to changes
    const unsubscribe = cartCount.subscribe((count) => updateBadge(count));
    
    // Clean up on swap to avoid multiple subscriptions if the component persists
    document.addEventListener("astro:before-swap", unsubscribe, { once: true });
  }

  // Run on initial load and every navigation
  setupCartBadge();
  document.addEventListener("astro:page-load", setupCartBadge);
</script>
