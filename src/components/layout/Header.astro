---
import CartButton from "../ui/CartButton.astro";
import { storeConfig } from "../../config/store.config";

const links = [
  { name: "Inicio", href: "/" },
  { name: "Productos", href: "/productos" },
  { name: "Nosotros", href: "/nosotros" },
];

const { pathname } = Astro.url;

// Check if user is authenticated
const isAdmin = Astro.cookies.get("admin_session")?.value === "authenticated";
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="glass border-b border-white/10 dark:border-slate-700/30">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between h-16 md:h-20">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-9 h-9 rounded-xl bg-yellow-400 flex items-center justify-center shadow-lg group-hover:shadow-yellow-500/30 transition-all font-bold text-lg text-black">
            {storeConfig.name?.charAt(0).toUpperCase() || "V"}
          </div>
          <span class="font-bold text-xl text-slate-900 dark:text-white tracking-tight">
            {storeConfig.name}
          </span>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-8">
          {links.map((link) => (
            <a
              href={link.href}
              class:list={[
                "text-sm font-medium transition-all duration-300 relative",
                pathname === link.href
                  ? "text-yellow-600 dark:text-yellow-400"
                  : "text-slate-600 dark:text-slate-300 hover:text-yellow-600 dark:hover:text-yellow-400",
              ]}
            >
              {link.name}
              {pathname === link.href && (
                <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-yellow-500 rounded-full" />
              )}
            </a>
          ))}
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Admin Link (Owner only) -->
          <a
            href="/admin"
            class:list={[
              "p-2 rounded-xl transition-all duration-300",
              isAdmin 
                ? "text-yellow-700 dark:text-yellow-400 bg-yellow-50 dark:bg-yellow-900/20" 
                : "text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300"
            ]}
            aria-label="Administración"
            title={isAdmin ? "Panel de Administración" : "Acceso Dueño"}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </a>

          <CartButton />

          <!-- Mobile Menu Toggle -->
          <button
            id="menu-toggle"
            class="md:hidden p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="Abrir menú"
          >
            <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="w-6 h-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <nav id="mobile-menu" class="md:hidden hidden pb-6">
        <div class="flex flex-col gap-2 pt-4 border-t border-slate-200 dark:border-slate-700">
          {links.map((link) => (
            <a
              href={link.href}
              class:list={[
                "px-4 py-3 rounded-xl text-sm font-medium transition-all",
                pathname === link.href
                  ? "bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-400"
                  : "text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800",
              ]}
            >
              {link.name}
            </a>
          ))}
          <a
            href="/carrito"
            class="px-4 py-3 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all flex items-center justify-between"
          >
            <span>🛒 Carrito</span>
            <span class="text-xs bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 px-2 py-0.5 rounded-full cart-count-mobile hidden">0</span>
          </a>
          <a
            href="/admin"
            class:list={[
              "px-4 py-3 rounded-xl text-sm font-medium transition-all flex items-center gap-2",
              isAdmin
                ? "bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-400"
                : "text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800"
            ]}
          >
             {isAdmin ? "⚙️ Panel Administración" : "👤 Acceso Dueño"}
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16 md:h-20"></div>

<script>
  import { cartCount } from "../../stores/cartStore";

  function setupHeader() {
    const menuBtn = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    const header = document.getElementById("main-header");
    const mobileCartBadge = document.querySelector(".cart-count-mobile");

    if (menuBtn && mobileMenu && iconOpen && iconClose) {
      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
        iconOpen.classList.toggle("hidden");
        iconClose.classList.toggle("hidden");
      });
    }

    if (header) {
      const handleScroll = () => {
        if (window.scrollY > 20) {
          header.classList.add("shadow-lg", "glass");
        } else {
          header.classList.remove("shadow-lg", "glass");
        }
      };
      window.addEventListener("scroll", handleScroll);
      handleScroll(); // initial
    }

    // Sync mobile cart badge
    if (mobileCartBadge) {
      const updateMobileBadge = (count: number) => {
        if (!mobileCartBadge) return;
        mobileCartBadge.textContent = count > 99 ? "99+" : String(count);
        if (count > 0) {
          mobileCartBadge.classList.remove("hidden");
        } else {
          mobileCartBadge.classList.add("hidden");
        }
      };
      
      updateMobileBadge(cartCount.get());
      const unsubscribe = cartCount.subscribe(updateMobileBadge);
      document.addEventListener("astro:before-swap", unsubscribe, { once: true });
    }
  }

  // Initial setup
  setupHeader();

  // Re-run setup after view transitions
  document.addEventListener("astro:page-load", setupHeader);
</script>
