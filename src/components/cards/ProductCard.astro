---
import { formatPrice } from "../../config/store.config";

const {
  id,
  name,
  price,
  discountPrice = 0,
  image,
  description = "",
  category = "",
  isNew = false,
  featured = false,
  benefits = [],
} = Astro.props;

const hasDiscount = discountPrice > 0;
---

<div
  class="card overflow-hidden group h-full flex flex-col animate-fade-in-up"
  data-product-id={id}
  data-product-name={name}
  data-product-price={price}
  data-product-discount-price={discountPrice}
  data-product-image={image}
  data-product-category={category}
>
  <!-- Image -->
  <a href={`/productos/${id}`} class="product-image-wrap block">
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />

    <!-- Badges -->
    <div class="absolute top-3 left-3 flex flex-col gap-2">
      {isNew && <span class="badge badge-new">NUEVO</span>}
      {hasDiscount && <span class="badge badge-sale">OFERTA</span>}
      {featured && !isNew && !hasDiscount && <span class="badge badge-featured">⭐ DESTACADO</span>}
    </div>
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-grow">
    <span class="text-xs font-semibold text-yellow-600 dark:text-yellow-400 uppercase tracking-wider mb-1">
      {category}
    </span>
    <a href={`/productos/${id}`}>
      <h3 class="text-lg font-bold text-slate-800 dark:text-slate-100 group-hover:text-yellow-700 dark:group-hover:text-yellow-400 transition-colors mb-1">
        {name}
      </h3>
    </a>
    <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mb-3">
      {description}
    </p>

    {benefits.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {benefits.slice(0, 3).map((b: string) => (
          <span class="text-xs px-2 py-0.5 bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-300 rounded-full">
            {b}
          </span>
        ))}
      </div>
    )}

    <!-- Price + Add to cart -->
    <div class="mt-auto pt-3 flex items-center justify-between border-t border-slate-100 dark:border-slate-800">
      <div>
        {hasDiscount ? (
          <div>
            <span class="text-xs text-slate-400 line-through">{formatPrice(price)}</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100">{formatPrice(discountPrice)}</div>
          </div>
        ) : (
          <div class="text-xl font-bold text-slate-900 dark:text-slate-100">{formatPrice(price)}</div>
        )}
      </div>

      <button
        class="add-to-cart-btn btn-primary btn !px-4 !py-2.5 !text-sm gap-1.5"
        aria-label={`Agregar ${name} al carrito`}
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span class="btn-text">Agregar</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { addToCart } from "../../stores/cartStore";

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".add-to-cart-btn").forEach((button) => {
      button.addEventListener("click", (e) => {
        const target = e.currentTarget;
        const card = target.closest("[data-product-id]");
        if (!card) return;

        const product = {
          id: card.getAttribute("data-product-id"),
          name: card.getAttribute("data-product-name"),
          price: parseInt(card.getAttribute("data-product-price"), 10),
          discountPrice: parseInt(card.getAttribute("data-product-discount-price") || "0", 10),
          image: card.getAttribute("data-product-image"),
          category: card.getAttribute("data-product-category") || "",
        };

        addToCart(product);

        // Visual feedback
        const btnText = target.querySelector(".btn-text");
        if (btnText) {
          const original = btnText.textContent;
          btnText.textContent = "✓ Añadido";
          target.classList.add("!bg-yellow-600");
          setTimeout(() => {
            btnText.textContent = original;
            target.classList.remove("!bg-yellow-600");
          }, 1200);
        }
      });
    });
  });
</script>
