---
import Layout from "../layouts/Layout.astro";
import CartView from "../components/cart/CartView.svelte";
---

<Layout title="Mi Carrito" description="Revisa tus productos y envía tu pedido por WhatsApp.">
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-10">
          <h1 class="section-title">Mi Carrito</h1>
          <p class="section-subtitle mx-auto">Revisa tus productos y envía tu pedido por WhatsApp</p>
        </div>

        <CartView client:load />
      </div>
    </div>
  </section>
</Layout>
