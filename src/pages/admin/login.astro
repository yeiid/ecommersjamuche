---
import Layout from "../../layouts/Layout.astro";
import { storeConfig } from "../../config/store.config";

// Si ya hay una cookie de sesión, redirigir al panel
const session = Astro.cookies.get("admin_session");
if (session?.value?.startsWith("role:")) {
  return Astro.redirect("/admin");
}
---

<Layout title="Login Administrador" description="Acceso al panel de control.">
  <section class="section min-h-[80vh] flex items-center justify-center">
    <div class="container mx-auto px-4">
      <div class="max-w-md mx-auto">
        <div class="glass-card p-8 md:p-10 animate-fade-in-up">
          <div class="text-center mb-8">
            <div class="w-16 h-16 bg-emerald-700 rounded-2xl flex items-center justify-center shadow-xl mx-auto mb-4">
              <span class="text-white font-bold text-3xl">
                {storeConfig.name?.charAt(0).toUpperCase() || "A"}
              </span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Panel de Control</h1>
            <p class="text-slate-500 dark:text-slate-400 text-sm mt-2">
              Ingresa tus credenciales para administrar <strong>{storeConfig.name}</strong>
            </p>
          </div>

          <form id="login-form" class="space-y-6">
            <div class="space-y-2">
              <label for="username" class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                Usuario (Opcional para Súper Admin)
              </label>
              <input
                type="text"
                id="username"
                name="username"
                placeholder="Nombre de usuario"
                class="input w-full"
              />
            </div>

            <div class="space-y-2">
              <label for="password" class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                Contraseña
              </label>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="••••••••"
                class="input w-full"
              />
            </div>

            <div id="error-message" class="hidden p-3 rounded-lg bg-rose-50 text-rose-700 text-xs font-medium text-center animate-shake">
              Credenciales incorrectas. Por favor reintenta.
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="btn btn-primary w-full py-4 text-base shadow-lg shadow-emerald-500/20"
            >
              <span id="btn-text">Ingresar</span>
              <div id="btn-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
            </button>
          </form>

          <div class="mt-8 text-center">
            <a href="/" class="text-xs text-slate-400 hover:text-emerald-600 transition-colors">
              ← Volver a la tienda
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorMsg = document.getElementById("error-message");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");
  const btnSpinner = document.getElementById("btn-spinner");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const username = formData.get("username");
      const password = formData.get("password");

      // Reset UI
      errorMsg?.classList.add("hidden");
      submitBtn.disabled = true;
      btnText?.classList.add("hidden");
      btnSpinner?.classList.remove("hidden");

      try {
        const response = await fetch("/api/auth", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, password }),
        });

        const data = await response.json();

        if (data.success) {
          // Redirect to admin
          window.location.href = "/admin";
        } else {
          errorMsg?.classList.remove("hidden");
          submitBtn.disabled = false;
          btnText?.classList.remove("hidden");
          btnSpinner?.classList.add("hidden");
        }
      } catch (err) {
        console.error("Login error:", err);
        submitBtn.disabled = false;
        btnText?.classList.remove("hidden");
        btnSpinner?.classList.add("hidden");
      }
    });
  }
</script>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }
  .animate-shake {
    animation: shake 0.2s ease-in-out 0s 2;
  }
</style>
