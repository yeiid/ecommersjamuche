---
import Layout from "../../layouts/Layout.astro";
import AdminPanel from "../../components/admin/AdminPanel.svelte";

// Verificar sesión
const session = Astro.cookies.get("admin_session");
if (!session || !session.value.startsWith("role:")) {
  return Astro.redirect("/admin/login");
}

const role = session.value.startsWith("role:super") ? "super" : "admin";
---

<Layout title="Administración" description="Panel de control para gestionar tu tienda.">
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="mb-10 text-center">
        <h1 class="section-title">Panel de Control</h1>
        <p class="section-subtitle mx-auto">Gestiona tus productos y configuración de forma sencilla</p>
      </div>

      <AdminPanel client:only="svelte" role={role} />
    </div>
  </section>
</Layout>
