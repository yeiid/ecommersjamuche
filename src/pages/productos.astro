---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/cards/ProductCard.astro";
import { storeConfig } from "../config/store.config";

// Get category filter from URL
const url = new URL(Astro.request.url);
const selectedCategory = url.searchParams.get("categoria") || "Todos";

const allProducts = storeConfig.products;
const filteredProducts =
  selectedCategory === "Todos"
    ? allProducts
    : allProducts.filter((p) => p.category === selectedCategory);
---

<Layout title="Productos" description="Explora nuestro catálogo completo de productos de cuidado corporal.">
  <section class="section">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="section-title">Nuestros Productos</h1>
        <p class="section-subtitle mx-auto">
          Descubre nuestra línea completa de productos naturales para tu bienestar
        </p>
      </div>

      <!-- Category Filters -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        <a
          href="/productos"
          class:list={[
            "px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300",
            selectedCategory === "Todos"
              ? "bg-yellow-400 text-black shadow-lg shadow-yellow-500/25"
              : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-yellow-500",
          ]}
        >
          Todos
        </a>
        {storeConfig.categories.map((cat) => (
          <a
            href={`/productos?categoria=${encodeURIComponent(cat)}`}
            class:list={[
              "px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300",
              selectedCategory === cat
                ? "bg-yellow-400 text-black shadow-lg shadow-yellow-500/25"
                : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-yellow-500",
            ]}
          >
            {cat}
          </a>
        ))}
      </div>

      <!-- Product Count -->
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        Mostrando <strong class="text-slate-800 dark:text-white">{filteredProducts.length}</strong> producto{filteredProducts.length !== 1 ? "s" : ""}
        {selectedCategory !== "Todos" && (
          <span> en <strong class="text-yellow-600 dark:text-yellow-400">{selectedCategory}</strong></span>
        )}
      </p>

      <!-- Grid -->
      {filteredProducts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {filteredProducts.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
            <svg class="w-10 h-10 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-2">No hay productos en esta categoría</h3>
          <a href="/productos" class="text-yellow-600 hover:text-yellow-700 font-medium">Ver todos los productos →</a>
        </div>
      )}
    </div>
  </section>
</Layout>
