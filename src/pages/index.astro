---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/cards/ProductCard.astro";
import { storeConfig, formatPrice } from "../config/store.config";

const featuredProducts = storeConfig.products.filter((p) => p.featured);
const newProducts = storeConfig.products.filter((p) => p.isNew);
---

<Layout>
  <!-- ═══ HERO SECTION ═══ -->
  <section class="hero-gradient relative overflow-hidden">
    <div class="hero-gradient-overlay absolute inset-0"></div>
    <div class="container mx-auto px-4 relative z-10 py-20 md:py-32 lg:py-40">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-yellow-500/20 text-yellow-400 rounded-full text-sm font-medium mb-6 animate-fade-in-up">
          🌿 Productos 100% naturales
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 animate-fade-in-up stagger-1">
          {storeConfig.tagline}
        </h1>
        <p class="text-lg md:text-xl text-yellow-100/80 mb-10 max-w-2xl leading-relaxed animate-fade-in-up stagger-2">
          {storeConfig.description}
        </p>
        <div class="flex flex-wrap gap-4 animate-fade-in-up stagger-3">
          <a href="/productos" class="btn btn-primary !bg-yellow-400 !text-black hover:!bg-yellow-500 !shadow-xl">
            Ver catálogo
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href={`https://wa.me/${storeConfig.whatsappNumber}`}
            target="_blank"
            rel="noopener"
            class="btn btn-whatsapp"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
            Contáctanos
          </a>
        </div>
      </div>
    </div>

    <!-- Decorative shapes -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" class="fill-surface-50 dark:fill-surface-900"/>
      </svg>
    </div>
  </section>

  <!-- ═══ CATEGORIES ═══ -->
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="section-title">Explora nuestras categorías</h2>
        <p class="section-subtitle mx-auto">Encuentra el producto perfecto para tu rutina de bienestar</p>
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        {storeConfig.categories.map((cat) => (
          <a
            href={`/productos?categoria=${encodeURIComponent(cat)}`}
            class="px-6 py-3 rounded-full border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-medium hover:border-yellow-500 hover:text-yellow-700 dark:hover:text-yellow-400 transition-all duration-300 hover:shadow-lg"
          >
            {cat}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED PRODUCTS ═══ -->
  <section class="section bg-white dark:bg-slate-900/50">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-4">
        <div>
          <h2 class="section-title">Productos destacados</h2>
          <p class="section-subtitle">Los favoritos de nuestros clientes</p>
        </div>
        <a href="/productos" class="btn btn-secondary">
          Ver todos →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard {...product} />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ BENEFITS ═══ -->
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="section-title">¿Por qué elegirnos?</h2>
        <p class="section-subtitle mx-auto">Nos comprometemos con tu bienestar en cada detalle</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-card p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center">
            <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-2">100% Natural</h3>
          <p class="text-slate-500 dark:text-slate-400 text-sm">Ingredientes naturales cuidadosamente seleccionados, libres de químicos dañinos.</p>
        </div>

        <div class="glass-card p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
            <svg class="w-8 h-8 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-2">Envío Rápido</h3>
          <p class="text-slate-500 dark:text-slate-400 text-sm">Coordinamos tu envío directamente por WhatsApp para que recibas tu pedido lo antes posible.</p>
        </div>

        <div class="glass-card p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-rose-100 dark:bg-rose-900/30 flex items-center justify-center">
            <svg class="w-8 h-8 text-rose-600 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-800 dark:text-slate-100 mb-2">Atención Personalizada</h3>
          <p class="text-slate-500 dark:text-slate-400 text-sm">Te asesoramos para encontrar los productos ideales según tu tipo de piel y necesidades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NEW ARRIVALS ═══ -->
  {newProducts.length > 0 && (
    <section class="section bg-white dark:bg-slate-900/50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-1.5 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 rounded-full text-sm font-semibold mb-4">
            ✨ Recién llegados
          </span>
          <h2 class="section-title">Lo nuevo en nuestra tienda</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {newProducts.map((product) => (
            <ProductCard {...product} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ CTA ═══ -->
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="hero-gradient rounded-3xl p-10 md:p-16 text-center relative overflow-hidden">
        <div class="hero-gradient-overlay absolute inset-0 rounded-3xl"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">¿Tienes preguntas?</h2>
          <p class="text-yellow-100/80 mb-8 max-w-xl mx-auto">
            Estamos aquí para ayudarte. Escríbenos por WhatsApp y te asesoraremos con todo el gusto.
          </p>
          <a
            href={`https://wa.me/${storeConfig.whatsappNumber}`}
            target="_blank"
            rel="noopener"
            class="btn btn-whatsapp text-base px-8 py-4"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
            Chatea con nosotros
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
