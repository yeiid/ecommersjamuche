---
import Layout from "../../layouts/Layout.astro";
import { storeConfig, formatPrice } from "../../config/store.config";

const { id } = Astro.params;

// Buscar el producto por ID
const product = storeConfig.products.find((p) => p.id === id);

// Si no existe, redirigir a 404
if (!product) {
  return Astro.redirect("/productos");
}

// Productos relacionados (misma categoría, excluyendo el actual)
const related = storeConfig.products
  .filter((p) => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

const hasDiscount = (product.discountPrice ?? 0) > 0;
const displayPrice = hasDiscount ? product.discountPrice! : product.price;
const savings = hasDiscount ? product.price - product.discountPrice! : 0;
---

<Layout
  title={product.name}
  description={product.description}
>
  <!-- Breadcrumb -->
  <div class="bg-surface-100 dark:bg-surface-800 border-b border-slate-200 dark:border-slate-800">
    <div class="container mx-auto px-4 py-3">
      <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-yellow-600 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/productos" class="hover:text-yellow-600 transition-colors">Productos</a>
        <span>/</span>
        <a
          href={`/productos?categoria=${encodeURIComponent(product.category)}`}
          class="hover:text-yellow-600 transition-colors"
        >
          {product.category}
        </a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-medium truncate max-w-[180px]">
          {product.name}
        </span>
      </nav>
    </div>
  </div>

  <!-- Contenido principal -->
  <section class="container mx-auto px-4 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- Imagen del producto -->
      <div class="relative">
        <!-- Badges -->
        <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
          {product.isNew && (
            <span class="badge badge-new">NUEVO</span>
          )}
          {hasDiscount && (
            <span class="badge badge-sale">OFERTA</span>
          )}
          {product.featured && !product.isNew && !hasDiscount && (
            <span class="badge badge-featured">⭐ DESTACADO</span>
          )}
        </div>

        <div class="aspect-square rounded-3xl overflow-hidden bg-surface-100 dark:bg-surface-800 shadow-2xl">
          <img
            src={product.image}
            alt={product.name}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="eager"
          />
        </div>
      </div>

      <!-- Información del producto -->
      <div class="space-y-6">
        <!-- Categoría -->
        <a
          href={`/productos?categoria=${encodeURIComponent(product.category)}`}
          class="inline-flex items-center gap-1 text-sm font-semibold text-yellow-600 dark:text-yellow-400 uppercase tracking-wider hover:underline"
        >
          {product.category}
        </a>

        <!-- Nombre -->
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight">
          {product.name}
        </h1>

        <!-- Descripción -->
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          {product.description}
        </p>

        <!-- Precio -->
        <div class="flex items-end gap-4">
          <div class="text-4xl font-black text-slate-900 dark:text-white">
            {formatPrice(displayPrice!)}
          </div>
          {hasDiscount && (
            <div class="space-y-0.5">
              <div class="text-lg text-slate-400 line-through">{formatPrice(product.price)}</div>
              <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">
                Ahorras {formatPrice(savings)}
              </div>
            </div>
          )}
        </div>

        <!-- Beneficios -->
        {product.benefits && product.benefits.length > 0 && (
          <div class="glass-card p-6">
            <h2 class="text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4">
              ✅ Beneficios clave
            </h2>
            <ul class="space-y-3">
              {product.benefits.map((benefit) => (
                <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
                  <div class="w-5 h-5 rounded-full bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center flex-shrink-0">
                    <svg class="w-3 h-3 text-yellow-600 dark:text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span class="text-sm font-medium">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- CTA Botones -->
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <!-- Agregar al carrito -->
          <button
            id="add-to-cart-detail"
            data-product-id={product.id}
            data-product-name={product.name}
            data-product-price={product.price}
            data-product-discount-price={product.discountPrice ?? 0}
            data-product-image={product.image}
            data-product-category={product.category}
            class="btn btn-primary flex-1 text-base py-4 gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span id="cart-btn-text">Agregar al carrito</span>
          </button>

          <!-- WhatsApp directo -->
          <a
            href={`https://wa.me/${storeConfig.whatsappNumber}?text=${encodeURIComponent(`¡Hola! Me interesa el producto *${product.name}* — ${formatPrice(displayPrice!)}. ¿Tienen disponibilidad?`)}`}
            target="_blank"
            rel="noopener"
            class="btn btn-whatsapp flex-1 text-base py-4"
          >
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Pedir por WhatsApp
          </a>
        </div>

        <!-- Tags de confianza -->
        <div class="flex flex-wrap gap-3 pt-2">
          <span class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            100% Natural
          </span>
          <span class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
            <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            Envío coordinado
          </span>
          <span class="flex items-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
            <svg class="w-4 h-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            Asesoría personalizada
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Productos relacionados -->
  {related.length > 0 && (
    <section class="section bg-white dark:bg-slate-900/50">
      <div class="container mx-auto px-4">
        <h2 class="section-title mb-2">También te puede interesar</h2>
        <p class="section-subtitle mb-10">Más productos de {product.category}</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {related.map((p) => (
            <a href={`/productos/${p.id}`} class="card overflow-hidden group h-full flex flex-col animate-fade-in-up hover:shadow-xl transition-shadow">
              <div class="product-image-wrap">
                <img src={p.image} alt={p.name} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <div class="p-4 flex flex-col flex-grow">
                <span class="text-xs font-semibold text-yellow-600 dark:text-yellow-400 uppercase tracking-wider mb-1">{p.category}</span>
                <h3 class="font-bold text-slate-800 dark:text-slate-100 group-hover:text-yellow-700 dark:group-hover:text-yellow-400 transition-colors mb-2 line-clamp-2">{p.name}</h3>
                <div class="mt-auto text-lg font-bold text-slate-900 dark:text-white">{formatPrice(p.discountPrice && p.discountPrice > 0 ? p.discountPrice : p.price)}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  import { addToCart } from "../../stores/cartStore";

  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("add-to-cart-detail");
    if (!btn) return;

    btn.addEventListener("click", () => {
      const product = {
        id: btn.getAttribute("data-product-id")!,
        name: btn.getAttribute("data-product-name")!,
        price: parseInt(btn.getAttribute("data-product-price")!, 10),
        discountPrice: parseInt(btn.getAttribute("data-product-discount-price") || "0", 10),
        image: btn.getAttribute("data-product-image")!,
        category: btn.getAttribute("data-product-category") || "",
      };

      addToCart(product);

      const btnText = document.getElementById("cart-btn-text");
      if (btnText) {
        btnText.textContent = "✓ ¡Añadido!";
        btn.classList.add("!bg-yellow-600");
        setTimeout(() => {
          btnText.textContent = "Agregar al carrito";
          btn.classList.remove("!bg-yellow-600");
        }, 1500);
      }
    });
  });
</script>
