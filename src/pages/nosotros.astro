---
import Layout from "../layouts/Layout.astro";
import { storeConfig } from "../config/store.config";

const { about } = storeConfig;

// Fallback en caso de que falten datos
const heroTitle = about?.heroTitle || "Nuestra Historia";
const heroSubtitle = about?.heroSubtitle || "Conoce nuestro compromiso.";
const historyTitle = about?.historyTitle || "🌿 Quiénes somos";
const historyContent = about?.historyContent?.replace("{name}", storeConfig.name) || "";
const missionTitle = about?.missionTitle || "💚 Nuestra misión";
const missionContent = about?.missionContent || "";
const valuesTitle = about?.valuesTitle || "✨ Nuestros valores";
const values = about?.values || [];
---

<Layout title="Nosotros" description={heroSubtitle}>
  <!-- Hero -->
  <section class="hero-gradient relative overflow-hidden">
    <div class="hero-gradient-overlay absolute inset-0"></div>
    <div class="container mx-auto px-4 relative z-10 py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6 animate-fade-in-up">
          {heroTitle}
        </h1>
        <p class="text-lg text-emerald-100/80 animate-fade-in-up stagger-1">
          {heroSubtitle}
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H0Z" class="fill-surface-50 dark:fill-surface-900"/>
      </svg>
    </div>
  </section>

  <!-- Content Sections -->
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto space-y-8">
        {historyContent && (
          <div class="glass-card p-8 md:p-10">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">{historyTitle}</h2>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-line">
              {historyContent}
            </p>
          </div>
        )}

        {missionContent && (
          <div class="glass-card p-8 md:p-10">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">{missionTitle}</h2>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-line">
              {missionContent}
            </p>
          </div>
        )}

        {values.length > 0 && (
          <div class="glass-card p-8 md:p-10">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">{valuesTitle}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6">
              {values.map((val: any) => (
                <div class="flex items-start gap-3 group">
                  <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                    <span class="text-lg">{val.icon}</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-slate-800 dark:text-white">{val.title}</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{val.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-white dark:bg-slate-900/50">
    <div class="container mx-auto px-4 text-center">
      <h2 class="section-title mb-4">¿Quieres saber más?</h2>
      <p class="section-subtitle mx-auto mb-8">
        Estamos encantados de ayudarte. Escríbenos y cuéntanos qué necesitas.
      </p>
      <a
        href={`https://wa.me/${storeConfig.whatsappNumber}`}
        target="_blank"
        rel="noopener"
        class="btn btn-whatsapp text-base px-8 py-4"
      >
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>
</Layout>
